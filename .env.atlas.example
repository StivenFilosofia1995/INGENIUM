# ============================================================
# ATLAS DEL INGENIUM — variables dedicadas solo al servidor que
# publica cartografia_del_ingenium_1.html en Railway.
#
# Copia este archivo a .env.atlas y rellena los valores reales.
# NUNCA subas .env.atlas al repositorio (ya está en .gitignore).
#
# Es un .env aparte del .env.example de la raíz (que es para el
# backend/frontend de FASE 0-1, hoy inactivos): este proyecto usa
# tablas nuevas (atlas_nodes / atlas_links, ver
# supabase/migrations/20260729000000_atlas_schema.sql), puede
# vivir en el MISMO proyecto de Supabase que ya tengan o en uno
# nuevo — no hace falta duplicar infraestructura, solo mantener
# la configuración de este componente separada.
# ============================================================

# URL del proyecto de Supabase (Project Settings → API → Project URL)
SUPABASE_URL=

# Llave pública "anon" (Project Settings → API → anon public)
# Es SEGURA de exponer en el HTML: la protección real la dan las
# políticas RLS de atlas_nodes/atlas_links, no el secreto de esta
# llave. NUNCA pongas aquí la service_role key.
SUPABASE_ANON_KEY=

# Puerto en el que Railway sirve el HTML (Railway lo inyecta solo;
# déjalo vacío en local y usa 8080 o el que prefieras para probar)
PORT=8080
