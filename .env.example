# ============================================================
# INGENIUM TRACKER — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ============================================================

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ingenium

# --- LLM de interpretación (§5.2) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# --- Fuentes externas (algunas requieren clave de contacto/API) ---
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
CROSSREF_MAILTO=
GOOGLE_BOOKS_API_KEY=
GEONAMES_USERNAME=

# --- Crawler dirigido ---
CRAWLER_USER_AGENT=IngeniumTrackerBot/0.1 (+mailto:REEMPLAZAR)
CRAWLER_DEFAULT_RPM=10

# --- Seguridad de endpoints de operación ---
ADMIN_TOKEN=

# --- Redis (jobs largos, opcional en FASE 0) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite, solo claves públicas) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
